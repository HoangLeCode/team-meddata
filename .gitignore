# Do not commit downloaded or private data (raw medical.csv stays ignored).
# Exception: the team's canonical CLEANED output is a Phase 2 deliverable. Remove a matching rule only when
# the professor explicitly says a specific instructor-provided sample belongs
# in Git.
/data/*
!/data/clean/
# Public geometry needed to render the county choropleth in deployment.
!/data/boundaries/
!/data/boundaries/ca_counties.geojson
!/data/boundaries/README.md
/data/clean/*
!/data/clean/providers_clean.parquet
!/data/clean/cleaning_audit.json
downloads/
*.csv
*.tsv
*.parquet
!data/clean/providers_clean.parquet
*.xlsx
*.xls
*.zip

# Do not commit credentials or local environment settings.
.env
.env.*

# Local operating-system files.
.DS_Store
Thumbs.db
__pycache__/
.pytest_cache/
